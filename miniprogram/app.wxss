page {
  background: #f6f7f4;
  color: #1c2520;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.break-all {
  word-break: break-all;
}

.status-badge {
  color: #2d6c5d;
  font-size: 22rpx;
  font-weight: 700;
}

.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero {
  padding: 36rpx 28rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6dd;
  border-radius: 16rpx;
}

.eyebrow {
  display: block;
  color: #2d6c5d;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 1rpx;
  margin-bottom: 10rpx;
}

.title {
  display: block;
  color: #12211c;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
}

.desc,
.muted {
  display: block;
  color: #60716a;
  font-size: 26rpx;
  line-height: 1.7;
  margin-top: 16rpx;
}

.grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-top: 24rpx;
}

.tool-card,
.panel {
  background: #ffffff;
  border: 1rpx solid #dfe6dd;
  border-radius: 14rpx;
  padding: 24rpx;
  margin-top: 22rpx;
  text-align: left;
}

.tool-card {
  min-height: 180rpx;
}

.tool-card text {
  display: block;
}

.tool-title,
.section-title {
  color: #172620;
  display: block;
  font-size: 30rpx;
  font-weight: 800;
}

.tool-desc {
  color: #60716a;
  display: block;
  font-size: 24rpx;
  line-height: 1.55;
  margin-top: 10rpx;
}

.primary,
.secondary {
  align-items: center;
  display: flex;
  font-size: 28rpx;
  font-weight: 700;
  height: 88rpx;
  justify-content: center;
  margin-top: 24rpx;
}

.primary {
  background: #146c5c;
  color: #ffffff;
}

.secondary {
  background: #eaf3ef;
  color: #146c5c;
}

.full {
  width: 100%;
}

.row,
.result-grid {
  align-items: center;
  display: flex;
  justify-content: space-between;
  margin-top: 18rpx;
}

.result-grid > view {
  background: #f6f7f4;
  border-radius: 12rpx;
  flex: 1;
  margin-right: 14rpx;
  padding: 20rpx;
}

.result-grid > view:last-child {
  margin-right: 0;
}

.metric-label {
  color: #60716a;
  display: block;
  font-size: 22rpx;
}

.metric-value {
  color: #12211c;
  display: block;
  font-size: 30rpx;
  font-weight: 800;
  margin-top: 6rpx;
}

.preview {
  background: #eef3ef;
  border-radius: 12rpx;
  height: 360rpx;
  width: 100%;
}

.file-line,
.recent {
  align-items: center;
  background: #f6f7f4;
  border-radius: 10rpx;
  display: flex;
  justify-content: space-between;
  margin-top: 14rpx;
  min-height: 70rpx;
  padding: 0 18rpx;
}

.error {
  color: #a33a2f;
  display: block;
  font-size: 24rpx;
  line-height: 1.6;
  margin-top: 18rpx;
}

.tiny {
  background: #eaf3ef;
  color: #146c5c;
  display: inline-flex;
  font-size: 22rpx;
  height: 56rpx;
  line-height: 56rpx;
  margin: 0 0 0 10rpx;
  padding: 0 18rpx;
}

.danger {
  background: #f8e9e5;
  color: #a33a2f;
}

.result-textarea,
.feedback-input {
  background: #f6f7f4;
  border-radius: 12rpx;
  box-sizing: border-box;
  color: #1c2520;
  font-size: 26rpx;
  line-height: 1.6;
  margin-top: 18rpx;
  min-height: 220rpx;
  padding: 20rpx;
  width: 100%;
}

.feedback-input {
  min-height: 160rpx;
}

.rating-row {
  align-items: center;
  display: flex;
  gap: 12rpx;
  margin-top: 16rpx;
}
