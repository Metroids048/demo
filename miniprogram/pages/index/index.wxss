.page {
  padding: 32rpx;
}

.hero,
.panel {
  background: #ffffff;
  border: 1rpx solid #dbe4dd;
  border-radius: 16rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.hero {
  background: #eef5f1;
}

.eyebrow,
.desc,
.muted,
.metric-label {
  color: #617067;
}

.eyebrow {
  display: block;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 16rpx;
}

.title {
  display: block;
  font-size: 56rpx;
  font-weight: 800;
  line-height: 1.08;
  margin-bottom: 20rpx;
}

.desc,
.muted {
  display: block;
  font-size: 30rpx;
  line-height: 1.6;
}

.primary,
.secondary {
  min-height: 88rpx;
  margin-top: 28rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.primary {
  background: #146c5c;
  color: #ffffff;
}

.secondary {
  background: #ffffff;
  color: #146c5c;
  border: 1rpx solid #146c5c;
}

.full {
  width: 100%;
}

.preview {
  width: 100%;
  height: 360rpx;
  border-radius: 12rpx;
  background: #eef5f1;
}

.row,
.label-row,
.result-grid {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 20rpx;
}

.result-grid > view {
  width: 48%;
  padding: 24rpx;
  border-radius: 12rpx;
  background: #eef5f1;
}

.metric-label,
.metric-value {
  display: block;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
}

.section-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.recent {
  width: 100%;
  margin-top: 12rpx;
  text-align: left;
  background: #f6f7f4;
  color: #1c2520;
}

.recent text {
  display: block;
}

.error {
  display: block;
  color: #a33c3c;
  margin-top: 16rpx;
  font-weight: 700;
}
